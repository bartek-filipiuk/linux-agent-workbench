# Default: ChatGPT/Codex subscription. Authenticate on the host: pnpm codex:login
LAW_PROVIDER=codex
# Optional: otherwise Codex chooses its default model.
# LAW_CODEX_MODEL=
# LAW_CODEX_BIN=/absolute/path/to/codex
# LAW_CODEX_HOME=/absolute/private/path/outside/your/workspace

# For separately billed Responses API, explicitly set LAW_PROVIDER=openai:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-sol

# Optional Jev Hybrid browser engine (separate TypeSafe API billing).
# Keep keys in the private app configuration, outside the agent workspace.
# TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-1.13.0
# TYPESAFE_PRICE_INPUT_PER_MTOK=0.042
